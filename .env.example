# Tukuru - configuracion. Copie a .env y ajuste. Todo es opcional salvo la camara y (para el juez) GEMINI_API_KEY.
# Las camaras (y sus zonas) tambien se pueden agregar desde el panel web (http://127.0.0.1:5000).

# ---- Gemini (juez que revisa el clip de un posible ocultamiento) -------------
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3-flash-preview  # modelo verificado en la cuenta del usuario (nov 2026); si da 503 vea docs/PRUEBAS.md
GEMINI_MAX_CALLS_PER_HOUR=120        # tope de gasto
GEMINI_COOLDOWN_SECONDS=10           # minimo entre consultas por persona
GEMINI_FRAMES=12                     # recortes por consulta (clip)
GEMINI_CROP_SIDE=448                 # lado maximo de cada recorte (menos = menos tokens)

# ---- Camaras (semilla inicial; luego viven en data/cameras.json) -------------
# Opcion A: URL completa.  Opcion B: campos separados (HOST, PROTOCOL, PORT, USER, PASSWORD, BRAND, PATH).
# CAMERA_1_NAME=Pasillo 1
# CAMERA_1_URL=rtsp://192.168.1.64:554/Streaming/Channels/102
# CAMERA_1_USER=admin
# CAMERA_1_PASSWORD=
# CAMERA_2_HOST=192.168.1.65
# CAMERA_2_BRAND=dahua                # generico|hikvision|dahua|tapo|reolink|uniview|axis
# Las zonas (estanteria, caja, salida, personal) se dibujan/pegan desde el panel por camara.
MAX_CAMERAS=3
# Donde guardar las contrasenas de camaras agregadas desde el panel: auto|keyring|file
#   auto = llavero del sistema si existe, si no data/cameras.json (permisos 600). Ya no hace falta ponerlas en este .env.
CREDENTIALS_STORE=auto

# ---- Rendimiento ------------------------------------------------------------
# El robo dura 1-3 s: se necesitan mas cuadros por segundo que para detectar somnolencia.
INFERENCE_FPS=8                      # analisis por segundo con gente en escena
IDLE_FPS=2                           # analisis por segundo con la tienda vacia
TRACK_BUFFER_FRAMES=60               # cuadros perdidos que ByteTrack conserva (60 ~= 7.5 s a 8 fps)
MAX_FRAME_SIDE=640                   # subir a 800-960 si las munecas se pierden en planos lejanos
YOLO_MODEL=yolov8n-pose.pt           # yolov8s-pose.pt detecta mejor las munecas (mas CPU)
DEVICE=auto                          # auto: CUDA si esta disponible, si no CPU; cpu|cuda:0|mps

# ---- Reglas de deteccion -----------------------------------------------------
CONCEAL_WINDOW_SECONDS=8             # tras alcanzar el estante, tiempo en que una mano al cuerpo cuenta
CONCEAL_MIN_SECONDS=0.6              # la mano debe quedarse junto al cuerpo al menos esto
RETURN_WINDOW_SECONDS=6              # misma mano al mismo sitio del estante en este tiempo = lo devolvio
CHECKOUT_MIN_SECONDS=3               # permanencia en caja para considerar que paso por caja
CLIP_SECONDS=4                       # segundos ANTERIORES al ocultamiento que entran al clip de Gemini
MIN_CONF_CONFIRM=0.6                 # confianza minima de Gemini para confirmar ocultamiento
MIN_CONF_CLEAR=0.6                   # confianza minima de Gemini para descartar el evento
LOCAL_POSSIBLE_SCORE=0.70            # respaldo SIN Gemini: puntuacion para "posible ocultamiento"
LOCAL_PROBABLE_SCORE=0.90            # respaldo SIN Gemini: puntuacion para "probable sustraccion"
ALERT_REPEAT_SECONDS=30             # minimo entre alertas del mismo nivel para una misma persona
SHADOW_MODE=false                    # true: registra eventos sin avisar ni enviar webhook (para calibrar)
CAMERA_OFFLINE_SECONDS=60            # alerta de sistema si la camara pierde senal

# ---- Alertas y panel ------------------------------------------------------------
# ALERT_WEBHOOK_URL=https://...      # POST JSON de cada alerta (WhatsApp/Telegram/Teams via integrador)
# TELEGRAM_BOT_TOKEN=                 # token de BotFather; nunca subirlo a Git
# TELEGRAM_CHAT_ID=                   # chat o grupo autorizado (ID numerico)
# TELEGRAM_ALLOWED_USER_IDS=          # IDs numericos de operadores separados por coma
# ML_SHADOW_MODEL=data/models_ml/candidato.json  # puntua alertas sin cambiar decisiones
ALERT_RETENTION_DAYS=30
WEB_HOST=127.0.0.1                   # 0.0.0.0 para verlo desde otra PC (exige usuario/clave)
WEB_PORT=5000
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
LOG_LEVEL=info
